# Supabase credentials (example — replace with real values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Database backend: 'supabase' | 'indexeddb' | 'local'
VITE_DB_BACKEND=supabase

# SAT task backend: 'supabase' | 'local'
# Use 'local' only when the .NET service is running on this computer.
VITE_SAT_BACKEND=supabase
VITE_LOCAL_SAT_BACKEND_URL=http://127.0.0.1:5080
# Temporary browser-to-local-backend key; prefer tunnel-layer authentication for production.
VITE_LOCAL_SAT_BACKEND_KEY=
